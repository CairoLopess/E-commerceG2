# Copie para .env (que não vai para o Git) e troque os valores.

# usuarios
DB_URL=jdbc:postgresql://localhost:5432/usuarios
DB_USER=postgres
DB_PASSWORD=postgres
# HS256: pelo menos 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-com-32-ou-mais-caracteres
JWT_EXPIRACAO=2h

# catalogo
MONGODB_URI=mongodb://localhost:27017/catalogo
